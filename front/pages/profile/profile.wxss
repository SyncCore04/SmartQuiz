.page-container {
  padding-bottom: calc(env(safe-area-inset-bottom) + 120rpx);
  background-color: #f5f3ff;
  min-height: 100vh;
}

/* 渐变头部 */
.header-bg {
  background: linear-gradient(135deg, #4F46E5, #7C3AED);
  padding: 48rpx 32rpx 70rpx;
  position: relative;
  overflow: hidden;
}

.wave {
  position: absolute;
  bottom: -2rpx;
  left: -10%;
  width: 120%;
  height: 50rpx;
  background: #f5f3ff;
  border-radius: 50% 50% 0 0;
}

.header-top {
  margin-bottom: 32rpx;
}

.user-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.avatar-wrap {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  padding: 4rpx;
}

.avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.nickname {
  font-size: 36rpx;
  font-weight: 800;
  color: #ffffff;
}

.user-level {
  display: inline-block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
  background: rgba(255, 255, 255, 0.15);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  margin-top: 8rpx;
}

.stats-row {
  display: flex;
  justify-content: space-around;
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(10px);
  border-radius: 20rpx;
  padding: 20rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 32rpx;
  font-weight: 800;
  color: #ffffff;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 4rpx;
}

/* 功能菜单 */
.menu-card {
  margin: -24rpx 32rpx 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 16rpx 0;
  box-shadow: 0 8rpx 28rpx rgba(79, 70, 229, 0.08);
  position: relative;
  z-index: 2;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #f5f3ff;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon-box {
  width: 60rpx;
  height: 60rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.menu-content {
  flex: 1;
}

.menu-title {
  font-size: 30rpx;
  color: #1e1b4b;
  font-weight: 600;
  display: block;
}

.menu-desc {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-top: 4rpx;
}

/* ========== 关于我们弹窗 ========== */
.popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
}

.popup-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  overflow: hidden;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.popup-sheet.popup-show {
  transform: translateY(0);
}

.popup-bar {
  width: 64rpx;
  height: 8rpx;
  background: #e0e0e0;
  border-radius: 4rpx;
  margin: 16rpx auto 0;
}

.popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 36rpx 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.popup-header-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1e1b4b;
}

.popup-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f5f3ff;
}

.popup-body {
  box-sizing: border-box;
  padding: 36rpx 36rpx;
  padding-bottom: calc(36rpx + env(safe-area-inset-bottom));
}

/* 品牌区域 */
.about-brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 36rpx;
}

.about-logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #ede9fe, #e0e7ff);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.about-app-name {
  font-size: 40rpx;
  font-weight: 800;
  color: #4F46E5;
  margin-bottom: 8rpx;
}

.about-slogan {
  font-size: 26rpx;
  color: #999;
  letter-spacing: 2rpx;
}

/* 品牌故事 */
.about-story-card {
  background: linear-gradient(135deg, #f5f3ff, #ede9fe);
  border-radius: 20rpx;
  padding: 28rpx 30rpx;
  margin-bottom: 36rpx;
  border: 2rpx solid #c4b5fd;
}

.about-story-text {
  font-size: 26rpx;
  color: #555;
  line-height: 1.8;
}

/* 特色功能 */
.about-features {
  display: flex;
  justify-content: space-around;
  margin-bottom: 40rpx;
}

.about-feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.about-feature-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background: #f5f3ff;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #c4b5fd;
}

.about-feature-name {
  font-size: 22rpx;
  color: #666;
  font-weight: 500;
}

/* 版本信息 */
.about-version {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.about-version-text {
  font-size: 24rpx;
  color: #bbb;
}

.about-copyright {
  font-size: 22rpx;
  color: #ccc;
}

.page-container {
  padding-bottom: calc(env(safe-area-inset-bottom) + 220rpx);
  background-color: #f5f3ff;
  min-height: 100vh;
}

/* 顶部进度条 */
.progress-header {
  background: linear-gradient(135deg, #4F46E5, #7C3AED);
  padding: 32rpx 32rpx 28rpx;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.progress-label {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 600;
}

.progress-type {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  background: rgba(255, 255, 255, 0.15);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.progress-bar-bg {
  height: 8rpx;
  border-radius: 4rpx;
  background: rgba(255, 255, 255, 0.2);
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  border-radius: 4rpx;
  background: #ffffff;
  transition: width 0.3s ease;
}

/* 题目区域 */
.question-section {
  background: #ffffff;
  margin: 24rpx 32rpx;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(79, 70, 229, 0.06);
}

.question-num-badge {
  display: inline-flex;
  background: linear-gradient(135deg, #4F46E5, #7C3AED);
  padding: 6rpx 20rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.badge-text {
  font-size: 24rpx;
  color: #ffffff;
  font-weight: 700;
}

.question-title {
  font-size: 34rpx;
  color: #1e1b4b;
  font-weight: 600;
  line-height: 1.7;
}

/* 选项列表 */
.options-list {
  padding: 0 32rpx;
}

.option-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid #e9e5ff;
  box-shadow: 0 2rpx 8rpx rgba(79, 70, 229, 0.03);
  transition: all 0.2s ease;
}

.option-selected {
  background: #ede9fe;
  border-color: #4F46E5;
  box-shadow: 0 4rpx 16rpx rgba(79, 70, 229, 0.12);
}

.option-key-box {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: #f5f3ff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
  border: 2rpx solid #e9e5ff;
}

.key-active {
  background: #4F46E5;
  border-color: #4F46E5;
}

.key-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #4F46E5;
}

.key-active .key-text {
  color: #ffffff;
}

.option-text {
  flex: 1;
  font-size: 30rpx;
  color: #1e1b4b;
}

.option-check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #ede9fe;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* 底部导航 */
.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  padding: 20rpx 32rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 20rpx);
  box-shadow: 0 -4rpx 16rpx rgba(79, 70, 229, 0.06);
  z-index: 100;
}

.nav-scroll {
  width: 100%;
  margin-bottom: 20rpx;
  white-space: nowrap;
}

.nav-list {
  /* 必须用 inline-flex：宽度由全部题号撑开，scroll-view 才能横向滚动；
     不能用 flex + justify-content:center，否则内容只占一屏宽，
     两侧溢出的题号（如第1-3题）将无法滚动到达 */
  display: inline-flex;
  gap: 12rpx;
}

.nav-dot {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #f5f3ff;
  flex-shrink: 0;
}

.nav-current {
  background: linear-gradient(135deg, #4F46E5, #7C3AED);
}

.nav-answered {
  background: #ede9fe;
}

.nav-num {
  font-size: 24rpx;
  color: #666;
  font-weight: 500;
}

.nav-current .nav-num {
  color: #ffffff;
  font-weight: 700;
}

.submit-area {
  display: flex;
  justify-content: center;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #4F46E5, #7C3AED);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(79, 70, 229, 0.3);
}

.submit-text {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
}

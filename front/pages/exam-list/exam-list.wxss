.page-container {
  padding-bottom: calc(env(safe-area-inset-bottom) + 120rpx);
  background-color: #f5f3ff;
  min-height: 100vh;
}

/* 顶部标题 */
.page-header {
  background: linear-gradient(135deg, #4F46E5, #7C3AED);
  padding: 40rpx 32rpx 56rpx;
}

.header-title {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.header-sub {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 考试卡片列表 */
.exam-list {
  padding: 0 32rpx;
  margin-top: -28rpx;
}

.exam-card {
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(79, 70, 229, 0.08);
}

.exam-cover-wrap {
  position: relative;
  width: 100%;
  height: 240rpx;
}

.exam-cover {
  width: 100%;
  height: 100%;
}

.exam-cover-mask {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 60rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.15));
}

.exam-status-pill {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}

.status-text {
  font-size: 22rpx;
  color: #ffffff;
  font-weight: 600;
}

.exam-body {
  padding: 24rpx;
}

.exam-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e1b4b;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.exam-meta-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.meta-chip {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: #f5f3ff;
  padding: 6rpx 14rpx;
  border-radius: 12rpx;
}

.meta-text {
  font-size: 22rpx;
  color: #666;
}

.exam-footer-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.exam-date {
  font-size: 24rpx;
  color: #999;
}

.exam-enter-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
  background: linear-gradient(135deg, #4F46E5, #7C3AED);
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
}

.enter-text {
  font-size: 24rpx;
  color: #ffffff;
  font-weight: 600;
}

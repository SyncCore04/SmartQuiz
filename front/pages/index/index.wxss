.page-container {
  padding-bottom: calc(env(safe-area-inset-bottom) + 120rpx);
  background-color: #f5f3ff;
  min-height: 100vh;
}

/* 顶部问候区 */
.header-section {
  background: linear-gradient(135deg, #4F46E5, #7C3AED);
  padding: 40rpx 32rpx 60rpx;
  border-radius: 0 0 40rpx 40rpx;
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}

.greeting-text {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 6rpx;
}

.greeting-sub {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

.header-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(10px);
}

.search-bar {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10px);
  border-radius: 40rpx;
  padding: 16rpx 28rpx;
}

.search-placeholder {
  margin-left: 14rpx;
  color: rgba(255, 255, 255, 0.7);
  font-size: 26rpx;
}

/* 学习数据概览 */
.stats-overview {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: #ffffff;
  margin: -36rpx 32rpx 0;
  border-radius: 24rpx;
  padding: 32rpx 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(79, 70, 229, 0.1);
  position: relative;
  z-index: 2;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 800;
  color: #4F46E5;
  margin-bottom: 4rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: #e9e5ff;
}

/* 轮播图 */
.swiper-wrap {
  margin: 24rpx 32rpx;
}

.swiper-box {
  height: 280rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(79, 70, 229, 0.15);
}

.swiper-img {
  width: 100%;
  height: 100%;
}

.swiper-mask {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 30rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.5));
}

.swiper-title {
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
}

/* 分类 */
.section {
  margin: 24rpx 32rpx;
}

.section-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title-text {
  font-size: 34rpx;
  font-weight: 700;
  color: #1e1b4b;
}

.section-more {
  font-size: 24rpx;
  color: #7C3AED;
}

.category-grid {
  display: flex;
  justify-content: space-between;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(79, 70, 229, 0.06);
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 160rpx;
}

.category-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.category-name {
  font-size: 26rpx;
  color: #1e1b4b;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.category-count {
  font-size: 20rpx;
  color: #999;
}

/* 公告栏 */
.notice-bar {
  display: flex;
  align-items: center;
  margin: 0 32rpx;
  padding: 18rpx 24rpx;
  background: linear-gradient(135deg, #ede9fe, #e0e7ff);
  border-radius: 16rpx;
}

.notice-icon-wrap {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.notice-text {
  flex: 1;
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #4F46E5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 热门题库 */
.hot-scroll {
  white-space: nowrap;
}

.hot-card {
  display: inline-flex;
  flex-direction: column;
  width: 300rpx;
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  margin-right: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(79, 70, 229, 0.06);
  vertical-align: top;
}

.hot-card-img-wrap {
  position: relative;
  width: 100%;
  height: 200rpx;
}

.hot-card-img {
  width: 100%;
  height: 100%;
}

.hot-card-tag {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  background: linear-gradient(135deg, #7C3AED, #4F46E5);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.hot-card-info {
  padding: 18rpx 20rpx;
  white-space: normal;
}

.hot-card-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1e1b4b;
  margin-bottom: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.hot-card-desc {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 14rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.hot-card-footer {
  display: flex;
  justify-content: space-between;
}

.hot-card-count {
  font-size: 20rpx;
  color: #4F46E5;
  font-weight: 600;
}

.hot-card-joined {
  font-size: 20rpx;
  color: #bbb;
}

/* 最近练习 */
.recent-list {
  display: flex;
  flex-direction: column;
}

.recent-item {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(79, 70, 229, 0.04);
}

.recent-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.recent-left {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.recent-title {
  font-size: 28rpx;
  color: #1e1b4b;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.recent-date {
  font-size: 22rpx;
  color: #999;
}

.recent-score {
  display: flex;
  align-items: baseline;
  flex-shrink: 0;
}

.score-num {
  font-size: 36rpx;
  font-weight: 800;
  color: #4F46E5;
}

.score-total {
  font-size: 22rpx;
  color: #bbb;
}

.page-container {
  padding-bottom: calc(env(safe-area-inset-bottom) + 160rpx);
  background-color: #f5f3ff;
  min-height: 100vh;
}

/* 得分展示区 */
.score-header {
  background: linear-gradient(135deg, #4F46E5, #7C3AED);
  padding: 60rpx 32rpx 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.score-display {
  display: flex;
  align-items: baseline;
  margin-bottom: 8rpx;
}

.score-number {
  font-size: 120rpx;
  font-weight: 800;
  color: #ffffff;
  line-height: 1;
}

.score-unit {
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-left: 8rpx;
}

.score-title {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 24rpx;
}

.score-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10px);
  padding: 10rpx 28rpx;
  border-radius: 30rpx;
}

.badge-text {
  font-size: 30rpx;
  color: #ffffff;
  font-weight: 700;
}

.badge-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 统计卡片 */
.stats-grid {
  display: flex;
  gap: 16rpx;
  margin: -40rpx 32rpx 0;
  position: relative;
  z-index: 2;
}

.stat-card {
  flex: 1;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 8rpx 24rpx rgba(79, 70, 229, 0.08);
}

.stat-correct {
  border-top: 4rpx solid #4F46E5;
}

.stat-wrong {
  border-top: 4rpx solid #FF6B6B;
}

.stat-time {
  border-top: 4rpx solid #7C3AED;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 800;
  color: #4F46E5;
  margin-bottom: 4rpx;
}

.wrong-num {
  color: #FF6B6B;
}

.stat-desc {
  font-size: 24rpx;
  color: #999;
}

/* 答题详情 */
.section {
  padding: 24rpx 32rpx;
}

.section-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title-text {
  font-size: 34rpx;
  font-weight: 700;
  color: #1e1b4b;
}

.section-count {
  font-size: 24rpx;
  color: #999;
}

.detail-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.detail-card {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(79, 70, 229, 0.04);
}

.detail-correct {
  border-left: 6rpx solid #4F46E5;
}

.detail-wrong {
  border-left: 6rpx solid #FF6B6B;
}

.detail-left {
  display: flex;
  align-items: flex-start;
  flex: 1;
  min-width: 0;
}

.detail-status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  margin-top: 10rpx;
  flex-shrink: 0;
}

.dot-correct {
  background: #4F46E5;
}

.dot-wrong {
  background: #FF6B6B;
}

.detail-info {
  flex: 1;
  min-width: 0;
}

.detail-title {
  font-size: 28rpx;
  color: #1e1b4b;
  line-height: 1.6;
  margin-bottom: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.detail-answers {
  display: flex;
  gap: 20rpx;
  font-size: 24rpx;
}

.my-answer, .correct-answer {
  color: #999;
}

.wrong-text {
  color: #FF6B6B;
  font-weight: 700;
}

.correct-text {
  color: #4F46E5;
  font-weight: 700;
}

.detail-num {
  font-size: 22rpx;
  color: #bbb;
  flex-shrink: 0;
  margin-left: 12rpx;
}

/* 底部按钮 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-around;
  background: #ffffff;
  padding: 20rpx 24rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 20rpx);
  box-shadow: 0 -4rpx 16rpx rgba(79, 70, 229, 0.06);
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.action-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #ede9fe;
  display: flex;
  align-items: center;
  justify-content: center;
}

.wrong-wrap {
  background: #fee2e2;
}

.gray-wrap {
  background: #f3f4f6;
}

.action-label {
  font-size: 22rpx;
  color: #666;
}

page {
  background-color: #f5f3ff;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 28rpx;
  color: #333;
}
.theme-color { color: #4F46E5; }
.theme-bg { background-color: #4F46E5; }
.theme-bg-light { background-color: #ede9fe; }
.accent-color { color: #7C3AED; }
.card {
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 28rpx rgba(79, 70, 229, 0.08);
  padding: 30rpx;
  margin: 20rpx 0;
}
.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1e1b4b;
  margin-bottom: 20rpx;
}
.divider {
  height: 1rpx;
  background: #e9e5ff;
  margin: 20rpx 0;
}
